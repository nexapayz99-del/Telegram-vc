[Unit]
Description=Audio Forwarder Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Telegram-vc
ExecStart=/root/Telegram-vc/bot/venv/bin/python -m bot.main
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=40
# make sure ffmpeg is found
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
